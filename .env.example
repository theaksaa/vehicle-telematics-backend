# PostgreSQL container
POSTGRES_DB=vehicle_telematics
POSTGRES_USER=telematics
POSTGRES_PASSWORD=change-me

# Spring datasource
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/vehicle_telematics
SPRING_DATASOURCE_USERNAME=telematics
SPRING_DATASOURCE_PASSWORD=change-me

# Initial administrator (local development only)
INITIAL_ADMIN_ENABLED=true
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_FIRST_NAME=System
INITIAL_ADMIN_LAST_NAME=Administrator
INITIAL_ADMIN_PASSWORD=change-me

# Session cookie: use true behind HTTPS in production
SESSION_COOKIE_SECURE=false

# MQTT broker (mutual TLS)
MQTT_ENABLED=true
MQTT_SERVER_URI=ssl://localhost:8883
MQTT_CLIENT_ID=vehicle-telematics-backend
MQTT_CA_CERTIFICATE=certs/client-ca.crt
MQTT_CLIENT_CERTIFICATE=certs/telemetry-backend.crt
MQTT_CLIENT_PRIVATE_KEY=certs/telemetry-backend.key
MQTT_CONNECTION_TIMEOUT_SECONDS=10
MQTT_KEEP_ALIVE_SECONDS=30
